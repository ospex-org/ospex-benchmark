# ---- Ospex public read path (live mode) ----
# Base URL of ospex-core-api. Defaults to the production API if unset.
OSPEX_API_URL=
# Supabase project URL + public anon key (read-only), used for the public
# reference tables: current_odds (reference odds), closing_lines (scoring),
# and odds_history first-appearance reads (watch mode's late-detection gate).
# Both are required in live mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Benchmark serving projection (optional; the publisher is off without it) ----
# The scoped `benchmark_writer` role's password. It holds SELECT and INSERT on
# the nine benchmark_* tables and nothing else, and reaches no protocol state.
# With this set, the host is derived from SUPABASE_URL above; without it, the
# publisher is disabled and every write returns `disabled`.
BENCHMARK_WRITER=
# A complete DSN instead, if the host keeps one. Takes precedence over the pair
# above and is passed to the driver unparsed.
BENCHMARK_DB_URL=
# Overrides for a pooler, a non-default database, or a scratch instance.
BENCHMARK_DB_HOST=
BENCHMARK_DB_PORT=
BENCHMARK_DB_NAME=
BENCHMARK_DB_USER=
# The project's CA certificate, as PEM. Supplying it turns on TLS chain
# verification; without it the connection is encrypted but NOT authenticated,
# because the direct endpoint presents a chain Node does not trust by default.
#
# ⚠ It does NOT apply to a BENCHMARK_DB_URL that states its own sslmode. The
#   driver parses SSL parameters out of a connection string and they override
#   anything supplied beside them, this CA included — so with such a DSN the URL
#   is the whole story. (And note the driver treats sslmode=require as
#   verify-full; `no-verify` is encrypt-without-verifying.)
BENCHMARK_DB_CA=

# ---- Provider credentials (preflight + live mode; the dry run needs none) ----
# A missing key produces an explicit credential_missing result for that arm.
# A local gitignored .env in the repo root is loaded automatically at startup;
# real environment variables always take precedence.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY is accepted as an alternative name for the Gemini key.
GEMINI_API_KEY=
XAI_API_KEY=
